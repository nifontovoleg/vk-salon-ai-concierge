# VK Community Bot
VK_GROUP_TOKEN=your_vk_group_token_here
VK_GROUP_ID=123456789

# OpenRouter LLM
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Database (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./data/salon.db

# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/salon

# Application
LOG_LEVEL=INFO
SALON_NAME=Салон красоты
SALON_ADDRESS=г. Москва, ул. Примерная, д. 1
SALON_PHONE=+7 (999) 123-45-67
SALON_WORKING_HOURS=Пн-Сб 10:00-20:00, Вс 11:00-18:00

# Seed data (optional, for initial setup)
SEED_ADMIN_VK_IDS=123456789
