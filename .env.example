# Сообщество ВКонтакте: Управление → Работа с API → Ключи доступа (права: сообщения)
VK_GROUP_TOKEN=
VK_GROUP_ID=

# LLM через OpenRouter (OpenAI-совместимый /chat/completions с tool calling)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_TOKENS=1024
# Сколько последних сообщений диалога из БД уходит в модель
DIALOG_HISTORY_LIMIT=20

# База: SQLite по умолчанию
DATABASE_URL=sqlite+aiosqlite:///./data/salon.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/salon

LOG_LEVEL=INFO

# Данные салона для промпта и ответов без AI
SALON_NAME=Салон красоты
SALON_ADDRESS=г. Москва, ул. Примерная, д. 1
SALON_PHONE=+7 (999) 123-45-67
# По этой строке строится сетка записи. Формат: «Пн-Сб 10:00-20:00, Вс 11:00-18:00».
# Дни, которых нет в строке, — выходные. Пусто — ежедневно 10:00-20:00.
SALON_WORKING_HOURS=Пн-Сб 10:00-20:00, Вс 11:00-18:00
# Часовой пояс салона (IANA)
TIMEZONE=Asia/Yekaterinburg
# Шаг сетки записи, минут
SLOT_STEP_MINUTES=30
# Праздники/нерабочие дни салона: даты через запятую, диапазоны через «..»
SALON_DAYS_OFF=

# Личные графики мастеров (пересекаются с часами салона). Мастера разделяются «|».
# Не указанный мастер работает по часам салона (или по графику из базы/seed).
# Пример: Анна=Пн-Ср 10:00-18:00 | Дмитрий=Чт-Вс 12:00-20:00
MASTER_SCHEDULES=
# Отпуска и выходные мастеров. Пример: Анна=2026-11-02, 2026-11-10..2026-11-15 | Дмитрий=31.12.2026
MASTER_DAYS_OFF=

# Клиент может отменить или перенести запись онлайн не позднее чем за N часов (0 — без ограничения)
CANCEL_MIN_HOURS=2

# VK ID администраторов через запятую. Активируются при каждом запуске бота
# и получают уведомления о записях и запросах «позвать администратора».
SEED_ADMIN_VK_IDS=

# Персональные данные (152-ФЗ)
# Спрашивать согласие перед отправкой свободного текста в модель
# Режим мастера-одиночки: мгновенный ответ новому клиенту (прайс + ближайшие окна),
# цены только из базы, без выбора мастера, запись кнопками прямо в диалоге.
SOLO_MODE=false
REQUIRE_CONSENT=true
# Ссылка на политику обработки ПДн салона (показывается в запросе согласия)
PRIVACY_POLICY_URL=
# Скрывать телефоны и email в тексте, который уходит в модель
MASK_PII=true
